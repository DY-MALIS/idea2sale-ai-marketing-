{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/ai.js": {
      "maxDuration": 300
    },
    "api/telegram/deliver.js": {
      "maxDuration": 300,
      "includeFiles": "node_modules/ffmpeg-static/ffmpeg"
    }
  },
  "crons": [
    {
      "path": "/api/telegram/run-scheduled",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/tiktok/publish?action=cron",
      "schedule": "0 4 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/config/check?action=health"
    },
    {
      "source": "/api/tiktok/webhook",
      "destination": "/api/tiktok/publish?action=webhook"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
