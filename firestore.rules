rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Helper for future admin features
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /test/connection {
      allow read: if true;
    }

    match /admins/{uid} {
      // Lets a signed-in user check only their own admin status client-side (e.g. to gate the
      // Telegram CRM/inbox UI). Cannot be used to enumerate other admins or write this doc.
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /audit_logs/{logId} {
      // Written only by the server (Admin SDK bypasses these rules). Readable by admins only.
      allow read: if isAdmin();
      allow list: if isAdmin();
      allow write: if false;
    }

    match /tiktok_automation_tokens/{docId} {
      // Access/refresh tokens for the shared TikTok connection used by the cron
      // auto-publisher (api/tiktok/publish.js's ?action=cron). Written and read
      // only by the server via the Admin SDK, which bypasses these rules --
      // denied to every client, admin included, since these are live secrets.
      allow read, write: if false;
    }

    match /tiktok_posts/{postId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      
      allow create: if isSignedIn() 
        && isValidId(postId)
        && incoming().userId == request.auth.uid
        && incoming().videoId is string
        && incoming().videoId.size() < 500
        && incoming().status == 'PROCESSING'
        && incoming().timestamp == request.time;
        
      allow update: if isAdmin()
        || (isSignedIn()
        && existing().userId == request.auth.uid
        && incoming().userId == request.auth.uid
        && (
          // Action: Update Status
          incoming().diff(existing()).affectedKeys().hasOnly(['status'])
          && incoming().status in ['PUBLISH_COMPLETE', 'FAILED']
        ));
        
      allow delete: if isAdmin();
    }

    match /scheduled_posts/{postId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      
      allow create: if isSignedIn()
        && isValidId(postId)
        && incoming().userId == request.auth.uid
        && incoming().content is string
        && incoming().content.size() <= 2000
        && incoming().platform in ['TIKTOK', 'INSTAGRAM', 'TWITTER', 'TELEGRAM']
        && incoming().status == 'PENDING';
        
      allow update: if isAdmin() || (isSignedIn()
        && existing().userId == request.auth.uid
        && incoming().userId == request.auth.uid
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'processingAt', 'publishedAt', 'duplicateSkipped', 'scheduledTime', 'content', 'mediaUrl', 'mediaName', 'mediaType', 'videoUrl', 'videoName', 'publishMode'])
        ));
        
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    match /content_plan_items/{itemId} {
      // A user's own AI-extracted content-calendar items (see the
      // extractContentPlan action in api/ai.js and AIAgent.tsx's plan-upload
      // UI). status/resultMediaUrl/errorMessage are set only by the server
      // (Admin SDK, via the daily cron in api/telegram/run-scheduled.js) as it
      // generates each item's image/video on its scheduled date.
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn()
        && isValidId(itemId)
        && incoming().userId == request.auth.uid
        && incoming().scheduledDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && incoming().type in ['image', 'video']
        && incoming().prompt is string
        && incoming().prompt.size() <= 2000
        && incoming().topic is string
        && incoming().topic.size() <= 200
        && incoming().status == 'PENDING';

      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow update: if false;
    }

    match /generation_history/{entryId} {
      // A per-user log of past AI generations (video, image, Facebook scan)
      // shown in each tool's "history" panel so a result isn't lost on
      // refresh. Written directly by the client (unlike content_plan_items,
      // which the server writes), since it's just a record of what the
      // user's own browser already generated.
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn()
        && isValidId(entryId)
        && incoming().userId == request.auth.uid
        && incoming().type in ['video', 'image', 'facebook_scan']
        && incoming().title is string
        && incoming().title.size() <= 200
        && (!('summary' in incoming()) || (incoming().summary is string && incoming().summary.size() <= 500))
        && (!('mediaUrl' in incoming()) || (incoming().mediaUrl is string && incoming().mediaUrl.size() <= 1000))
        && (!('mediaType' in incoming()) || incoming().mediaType in ['photo', 'video'])
        && (!('payload' in incoming()) || incoming().payload is map);

      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow update: if false;
    }

    match /facebook_scan_leads/{leadId} {
      // A scanned lead's pitch context, keyed by a short id used as a
      // Telegram /start deep-link payload (t.me/<bot>?start=<leadId>) --
      // the payload itself can't hold a full lead record, so the client
      // writes it here first and the bot's own webhook (Admin SDK, bypasses
      // these rules) reads it back when that link is opened.
      allow read: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);

      allow create: if isSignedIn()
        && isValidId(leadId)
        && incoming().ownerId == request.auth.uid
        && incoming().businessName is string
        && incoming().businessName.size() <= 200
        && incoming().businessType is string
        && incoming().businessType.size() <= 120
        && incoming().recommendedService is string
        && incoming().recommendedService.size() <= 500
        && incoming().inboxMessage is string
        && incoming().inboxMessage.size() <= 1500;

      allow delete: if isAdmin() || (isSignedIn() && existing().ownerId == request.auth.uid);
      allow update: if false;
    }

    match /saved_leads/{leadId} {
      // A Facebook Scanner lead the owner chose to keep past that one scan
      // session (see "Save to CRM" in FacebookScanner.tsx / the "Saved Leads"
      // tab in CRM.tsx). Same owner-scoped shape as facebook_scan_leads above.
      allow read: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);

      allow create: if isSignedIn()
        && isValidId(leadId)
        && incoming().ownerId == request.auth.uid
        && incoming().businessName is string
        && incoming().businessName.size() <= 200
        && incoming().businessType is string
        && incoming().businessType.size() <= 120
        && incoming().recommendedService is string
        && incoming().recommendedService.size() <= 500
        && incoming().inboxMessage is string
        && incoming().inboxMessage.size() <= 1500;

      allow delete: if isAdmin() || (isSignedIn() && existing().ownerId == request.auth.uid);
      allow update: if false;
    }

    match /audience_activity/{activityId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      
      allow create: if isSignedIn()
        && isValidId(activityId)
        && incoming().userId == request.auth.uid
        && incoming().dayOfWeek in ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday']
        && incoming().hour >= 0 && incoming().hour <= 23
        && incoming().intensity is number;
        
      allow update: if isAdmin() || (isSignedIn()
        && existing().userId == request.auth.uid
        && incoming().userId == request.auth.uid
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['intensity', 'updatedAt'])
        ));
        
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    match /campaigns/{campaignId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      
      allow create: if isSignedIn()
        && isValidId(campaignId)
        && incoming().userId == request.auth.uid
        && incoming().name is string
        && incoming().name.size() <= 200
        && incoming().platform in ['TikTok', 'Facebook', 'Instagram']
        && incoming().frequency in ['Daily', 'Weekly', 'Custom']
        && incoming().status == 'Active';
        
      allow update: if isAdmin() || (isSignedIn()
        && existing().userId == request.auth.uid
        && incoming().userId == request.auth.uid
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'name', 'frequency', 'platform', 'updatedAt'])
        ));
        
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    match /reply_rules/{ruleId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      
      allow create: if isSignedIn()
        // && isValidId(ruleId) // auto-ids might fail isValidId if they have weird chars, but Firestore auto ID is usually fine.
        && incoming().userId == request.auth.uid
        && incoming().trigger is string
        && incoming().trigger.size() <= 500
        && incoming().response is string
        && incoming().response.size() <= 2000
        && incoming().platform in ['TikTok', 'Facebook', 'Instagram', 'TELEGRAM'];
        
      allow update: if isAdmin() || (isSignedIn()
        && existing().userId == request.auth.uid
        && incoming().userId == request.auth.uid
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['trigger', 'response', 'platform', 'updatedAt'])
        ));
        
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    match /business_profiles/{profileId} {
      allow read: if isAdmin() || (isSignedIn() && profileId == request.auth.uid);

      // telegramBotToken/telegramChatId let a user post scheduled Telegram content
      // to their own channel instead of the app's shared default one -- optional
      // (the client always sends both as strings, empty when unset) so existing
      // profiles created before this field existed still satisfy these rules.
      allow create: if isSignedIn()
        && profileId == request.auth.uid
        && incoming().userId == request.auth.uid
        && incoming().businessName is string
        && incoming().businessName.size() <= 200
        && incoming().logoDataUrl is string
        && incoming().logoDataUrl.size() <= 400000
        && incoming().directory is list
        && incoming().directory.size() <= 200
        && (!('telegramBotToken' in incoming()) || (incoming().telegramBotToken is string && incoming().telegramBotToken.size() <= 100))
        && (!('telegramChatId' in incoming()) || (incoming().telegramChatId is string && incoming().telegramChatId.size() <= 100))
        && (!('telegramBotActive' in incoming()) || incoming().telegramBotActive is bool);

      // telegramBotActive is set server-side only (activateOwnBot in
      // api/telegram/webhook.js, via the Admin SDK, which bypasses these rules
      // entirely) -- allowed here only so a client's merge write that happens to
      // carry the existing value forward still validates; a client can't set it
      // to anything the Admin SDK didn't already put there since Admin SDK
      // writes never go through this rule at all.
      allow update: if isSignedIn()
        && profileId == request.auth.uid
        && existing().userId == request.auth.uid
        && incoming().userId == request.auth.uid
        && incoming().businessName is string
        && incoming().businessName.size() <= 200
        && incoming().logoDataUrl is string
        && incoming().logoDataUrl.size() <= 400000
        && incoming().directory is list
        && incoming().directory.size() <= 200
        && (!('telegramBotToken' in incoming()) || (incoming().telegramBotToken is string && incoming().telegramBotToken.size() <= 100))
        && (!('telegramChatId' in incoming()) || (incoming().telegramChatId is string && incoming().telegramChatId.size() <= 100))
        && (!('telegramBotActive' in incoming()) || incoming().telegramBotActive is bool);

      allow delete: if isSignedIn() && profileId == request.auth.uid;
    }

    match /agent_conversations/{profileId} {
      // AI Agent chat memory: text-only conversation history so the agent keeps
      // context across page reloads/sessions, plus a `sessions` array of past
      // conversations ("Story" history) capped to match the client's own
      // MAX_SESSIONS -- without bounding it here too, a signed-in user's own
      // client could write an unbounded sessions array straight at Firestore
      // and eventually blow past the 1MB document size limit. No images are
      // stored here (kept client-side only), so length is the only cap needed.
      allow read: if isAdmin() || (isSignedIn() && profileId == request.auth.uid);

      allow create: if isSignedIn()
        && profileId == request.auth.uid
        && incoming().userId == request.auth.uid
        && incoming().messages is list
        && incoming().messages.size() <= 40
        && incoming().sessions is list
        && incoming().sessions.size() <= 20;

      allow update: if isSignedIn()
        && profileId == request.auth.uid
        && existing().userId == request.auth.uid
        && incoming().userId == request.auth.uid
        && incoming().messages is list
        && incoming().messages.size() <= 40
        && incoming().sessions is list
        && incoming().sessions.size() <= 20;

      allow delete: if isSignedIn() && profileId == request.auth.uid;
    }

    match /telegram_leads/{leadId} {
      // Written only by the server (Admin SDK bypasses these rules). The shared
      // bot's leads have no ownerId (null) and stay admin-only, as before -- a
      // per-user bot's leads (see activateOwnBot in api/telegram/webhook.js) also
      // let that bot's own owner read (not list-all -- their client query must
      // filter by ownerId == their own uid for the list rule to be satisfiable).
      allow read: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow write: if false;
    }

    match /telegram_messages/{messageId} {
      // Written only by the server (Admin SDK bypasses these rules). Same owner
      // rationale as telegram_leads.
      allow read: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow write: if false;
    }

    match /telegram_channel_engagement/{engagementId} {
      // Telegram webhook writes reaction aggregates and identifiable reaction events.
      // Admins can read them for CRM analytics; clients can never write them.
      allow read: if isAdmin();
      allow list: if isAdmin();
      allow write: if false;
    }

    match /settings/automation {
      // Shared on/off switch for the Telegram bot's auto-reply (rule-matched and AI
      // fallback) behavior -- api/telegram/webhook.js reads this before replying.
      // Readable by any signed-in user so the UI can show accurate ACTIVE/PAUSED
      // status; writable by admins only since it pauses live customer-facing
      // replies for the one shared bot every business using this deployment uses.
      allow read: if isSignedIn();
      allow write: if isAdmin() && incoming().active is bool;
    }

    match /settings/{settingId} {
      // Per-user equivalent of settings/automation above, one doc per owner
      // (id "automation_{uid}") for a user who has activated their own bot
      // (see activateOwnBot in api/telegram/webhook.js) -- only that owner
      // (or an admin) may toggle their own bot's auto-reply.
      allow read: if isSignedIn() && settingId == ('automation_' + request.auth.uid);
      allow write: if isSignedIn()
        && settingId == ('automation_' + request.auth.uid)
        && incoming().active is bool;
    }
  }
}
