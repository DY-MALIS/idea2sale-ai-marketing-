{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/ai.js": {
      "maxDuration": 180
    }
  },
  "crons": [
    {
      "path": "/api/telegram/run-scheduled",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
