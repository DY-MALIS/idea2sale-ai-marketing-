# --- Firebase (client, safe to expose) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# --- Firebase Admin (server-only) ---
# FIREBASE_PROJECT_ID defaults to VITE_FIREBASE_PROJECT_ID if unset.
FIREBASE_PROJECT_ID=
FIREBASE_FIRESTORE_DATABASE_ID=
# Only needed if the deploy target has no Google Application Default Credentials
# (e.g. most Vercel deployments). Leave blank to fall back to ADC.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- AI providers ---
GEMINI_API_KEY=
OPEN_ROUTER_API_KEY=
OPEN_ROUTER_MODEL=openai/gpt-4o-mini
OPEN_ROUTER_AGENT_MODEL=
OPEN_ROUTER_IMAGE_MODEL=bytedance-seed/seedream-4.5
OPEN_ROUTER_TTS_MODEL=openai/gpt-audio-mini
OPEN_ROUTER_TTS_VOICE=alloy
OPEN_ROUTER_VIDEO_MODEL=google/veo-3.1
# Optional: enriches product research / competitor context in api/ai.js.
X_BEARER_TOKEN=

# --- TikTok (Content Posting API) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
# Must include video.upload and video.publish for posting to work at all.
# user.info.basic/user.info.stats alone only supports read-only profile lookups.
TIKTOK_SCOPES=user.info.basic,user.info.stats,video.upload,video.publish
# 'inbox' (default, safe): sends to the user's TikTok inbox to finish/post manually.
# 'direct': publishes immediately as TIKTOK_PRIVACY_LEVEL. Only use once the
# TikTok app is audited — unaudited apps are restricted to private viewing anyway.
TIKTOK_POST_MODE=inbox
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
# Fallback numbers shown on the public TikTok stats widget when the API is unavailable.
TIKTOK_PUBLIC_HANDLE=ai.cafe4
TIKTOK_PUBLIC_FOLLOWERS=
TIKTOK_PUBLIC_FOLLOWING=
TIKTOK_PUBLIC_LIKES=
TIKTOK_PUBLIC_VIDEO_COUNT=

# --- Cloudinary (media hosting for Telegram scheduling + TikTok photo posts) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Telegram (scheduled broadcast posts + chatbot) ---
TELEGRAM_BOT_TOKEN=
# Chat/channel ID the scheduler posts to. Scheduled Telegram posts silently
# fail with "Telegram is not configured" until this is set.
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_SETUP_KEY=

# --- QStash (precise-time delivery for scheduled posts) ---
QSTASH_TOKEN=
QSTASH_URL=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Deployment ---
APP_URL=
PUBLIC_APP_URL=
# Shared secret Vercel Cron / the GitHub Action send to authenticate calls to
# /api/telegram/run-scheduled. Recommended in production; if unset, the
# endpoint accepts unauthenticated calls (low risk — it only fires posts that
# are already due — but should still be set).
CRON_SECRET=
