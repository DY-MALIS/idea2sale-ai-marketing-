# --- Firebase (client, safe to expose) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# --- Firebase Admin (server-only) ---
# FIREBASE_PROJECT_ID defaults to VITE_FIREBASE_PROJECT_ID if unset.
FIREBASE_PROJECT_ID=
FIREBASE_FIRESTORE_DATABASE_ID=
# Only needed if the deploy target has no Google Application Default Credentials
# (e.g. most Vercel deployments). Leave blank to fall back to ADC.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- AI providers ---
OPEN_ROUTER_API_KEY=
# Paid video submissions have a dedicated, fail-closed per-user quota. Status
# polling uses a separate larger quota and does not consume the general AI one.
VIDEO_GENERATION_RATE_LIMIT_PER_HOUR=3
VIDEO_GENERATION_IP_RATE_LIMIT_PER_HOUR=6
VIDEO_STATUS_RATE_LIMIT_PER_HOUR=300
# Gemini narration uses the existing OpenRouter key, not a separate Google key.
# Live/paid tests require explicit user approval.
OPEN_ROUTER_TTS_GEMINI_MODEL=google/gemini-3.1-flash-tts-preview
# Natural Gemini Khmer speech is the default. Set this to edge only when a
# deployment must force the simpler fallback voice.
KHMER_TTS_PROVIDER=gemini
# Optional HeyGen stock voice IDs. Set these to explicit Khmer-compatible male
# and female voices to keep the generated presenter's voice matched to sex.
OPEN_ROUTER_HEYGEN_MALE_VOICE_ID=
OPEN_ROUTER_HEYGEN_FEMALE_VOICE_ID=
OPEN_ROUTER_MODEL=openai/gpt-5.6-luna
OPEN_ROUTER_AGENT_MODEL=openai/gpt-5.6-luna
OPEN_ROUTER_IMAGE_MODEL=bytedance-seed/seedream-5-0-pro
OPEN_ROUTER_TTS_MODEL=openai/gpt-audio-mini
OPEN_ROUTER_TTS_VOICE=alloy
OPEN_ROUTER_VIDEO_MODEL=google/veo-3.1-lite
# Khmer talking videos intentionally use the fixed, budget-approved
# bytedance/seedance-2.0-mini model; it is not environment-configurable.
# Optional: enriches product research / competitor context in api/ai.js.
X_BEARER_TOKEN=

# --- TikTok (Content Posting API) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
# Must include video.upload and video.publish for posting to work at all.
# user.info.basic/user.info.stats alone only supports read-only profile lookups.
TIKTOK_SCOPES=user.info.basic,user.info.stats,video.upload,video.publish
# 'inbox' (default, safe): sends to the user's TikTok inbox to finish/post manually.
# 'direct': publishes immediately as TIKTOK_PRIVACY_LEVEL. Only use once the
# TikTok app is audited — unaudited apps are restricted to private viewing anyway.
TIKTOK_POST_MODE=inbox
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
# Fallback numbers shown on the public TikTok stats widget when the API is unavailable.
TIKTOK_PUBLIC_HANDLE=ai.cafe4
TIKTOK_PUBLIC_FOLLOWERS=
TIKTOK_PUBLIC_FOLLOWING=
TIKTOK_PUBLIC_LIKES=
TIKTOK_PUBLIC_VIDEO_COUNT=

# --- Meta Ad Library (optional EU/UK competitor-ad enrichment) ---
# Create an access token through developers.facebook.com with ads_read. The
# server uses only ACCESS_TOKEN; APP_ID/APP_SECRET are retained as setup notes
# and must never be exposed to the browser. Meta provides commercial ads via
# this API only for EU/UK delivery. Cambodia and other non-EU scans continue
# to use grounded public-web research because the API returns only political/
# issue ads in those countries. Organic Facebook posts are not covered.
META_AD_LIBRARY_APP_ID=
META_AD_LIBRARY_APP_SECRET=
META_AD_LIBRARY_ACCESS_TOKEN=

# --- Direct public Facebook/TikTok activity (optional) ---
# Search engines frequently do not index recent social posts. An Apify token
# enables direct lookup of posts/videos from the official public Page/profile
# URLs already verified by Competitor Scan. This is server-only and uses paid
# Actors; the app limits each profile to 14 recent results and stays fully
# functional through web-search fallback when the token is blank.
APIFY_API_TOKEN=
# Also accepted for compatibility with Apify CLI/integration environments:
# APIFY_TOKEN=
# Optional actor overrides. Defaults shown below are used when left blank.
APIFY_FACEBOOK_POSTS_ACTOR=apify/facebook-posts-scraper
APIFY_TIKTOK_ACTOR=clockworks/tiktok-scraper

# --- ImageKit (media hosting for Telegram scheduling + TikTok photo posts) ---
# Public/private keys and URL endpoint are available under ImageKit Developer options.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# --- Resend (automated outreach email for Facebook Scanner leads) ---
# Free tier: https://resend.com. Without a key, "Send Email" in Facebook
# Scanner returns a clear "not configured" error instead of failing silently.
RESEND_API_KEY=
# Must be on a domain verified in Resend to send to arbitrary lead addresses;
# the shared onboarding@resend.dev sender only delivers to the account's own
# verified email, so it's fine for a quick test but not for real leads.
RESEND_FROM_EMAIL=onboarding@resend.dev
# Optional: 429s outreach-email requests above this many per hour per IP.
EMAIL_RATE_LIMIT_PER_HOUR=20

# --- Telegram (scheduled broadcast posts + chatbot) ---
TELEGRAM_BOT_TOKEN=
# Chat/channel ID the scheduler posts to. Scheduled Telegram posts silently
# fail with "Telegram is not configured" until this is set.
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_SETUP_KEY=

# --- QStash (precise-time delivery for scheduled posts) ---
QSTASH_TOKEN=
QSTASH_URL=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Both signing keys are required. /api/telegram/deliver fails closed if either
# is missing, so an unsigned caller cannot trigger video delivery work.

# --- Deployment ---
APP_URL=
PUBLIC_APP_URL=
# Shared secret Vercel Cron / the GitHub Action send to authenticate calls to
# /api/telegram/run-scheduled. Required: if unset, the endpoint fails closed
# with HTTP 500 and no scheduled posts are processed.
CRON_SECRET=
